---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TeamCard from '../components/TeamCard.astro';

const values = [
  { title: 'Modern szabványok', text: 'A legújabb webes megoldásokkal dolgozunk, hogy az oldalad gyors, biztonságos és jól kereshető legyen.' },
  { title: 'Őszinteség', text: 'Új csapat vagyunk, és ezt nem titkoljuk. Nem ígérünk többet, mint amit tényleg megvalósítunk.' },
  { title: 'Rugalmasság', text: 'Kis csapatként gyorsan reagálunk, és az igényeidhez igazodunk, nem egy merev folyamathoz.' },
];
const stack = ['Astro', 'Next.js', 'Tailwind CSS'];
const milestones = [
  { label: 'Most', text: 'Elkészültek a mintaprojektjeink, és összeállt a technológiai alapunk.' },
  { label: 'Következő lépés', text: 'Az első kisvállalkozásokkal közösen építjük meg az oldalaikat, elégedettségi garanciával.' },
  { label: 'Célunk', text: 'Hosszú távú partnerség az ügyfeleinkkel, és valódi projektekből származó referenciák.' },
];
const team = [
  { name: 'Varga Bence', role: 'Társalapító, fejlesztő', bio: 'Az Astro és a Next.js világában otthonos, a gyors és tiszta kód híve.' },
  { name: 'Tóth Réka', role: 'Társalapító, fejlesztő és dizájner', bio: 'A Tailwind CSS és a mobil-első tervezés az erőssége, az első vázlattól a kész oldalig.' },
];
---
<Layout title="Rólunk | Lumen műhely" description="Két elhivatott fiatal fejlesztő vagyunk, akik Astro, Next.js és Tailwind CSS technológiával segítünk a kisvállalkozásoknak kitűnni.">
  <PageHeader title="Két fejlesztő, friss szemlélet" lead="Most indítjuk a vállalkozásunkat. Modern technológiákkal segítünk a kisvállalkozásoknak kitűnni az elavult, lassú weboldalak tengeréből." />

  <section class="mx-auto max-w-6xl px-5 py-12" aria-labelledby="story-title">
    <h2 id="story-title" class="font-display text-4xl font-extrabold tracking-tight">Miért indultunk el?</h2>
    <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-mist">
      Sok kisvállalkozás oldala lassú, nehezen használható telefonon, és alig találják meg a keresőben. Mi a legújabb webes szabványokkal építünk, hogy ez ne így legyen. Még nincs hosszú ügyféllistánk, viszont van friss tudásunk, sok energiánk, és minden projektet úgy kezelünk, mintha az első referenciánk lenne.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Használt technológiák">
      {stack.map((s) => <li class="glass rounded-full px-4 py-2 text-sm font-semibold">{s}</li>)}
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-5 py-12 md:grid-cols-3" aria-labelledby="values-title">
    <h2 id="values-title" class="sr-only">Értékeink</h2>
    {values.map((v) => (
      <article class="glass rounded-2xl p-7 transition duration-300 hover:-translate-y-1">
        <h3 class="font-display text-xl font-bold">{v.title}</h3>
        <p class="mt-2 text-mist">{v.text}</p>
      </article>
    ))}
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="history-title">
    <h2 id="history-title" class="font-display text-4xl font-extrabold tracking-tight">Hol tartunk, merre tartunk?</h2>
    <ol class="mt-10 space-y-4 border-l border-white/15 pl-8">
      {milestones.map((m) => (
        <li class="relative">
          <span class="absolute -left-[2.45rem] top-2 h-3 w-3 rounded-full bg-amber ring-4 ring-ink" aria-hidden="true"></span>
          <p class="font-display text-2xl font-extrabold text-iris">{m.label}</p>
          <p class="text-mist">{m.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="team-title">
    <h2 id="team-title" class="font-display text-4xl font-extrabold tracking-tight">Mi vagyunk a Lumen műhely</h2>
    <div class="mt-10 grid max-w-3xl gap-5 sm:grid-cols-2">
      {team.map((t) => <TeamCard {...t} />)}
    </div>
  </section>
</Layout>
