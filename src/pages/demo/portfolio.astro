---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoHeader from '../../components/demo/DemoHeader.astro';
import DemoFooter from '../../components/demo/DemoFooter.astro';
import DemoArt from '../../components/DemoArt.astro';
const works = [
  { t: 'Kávézó arculat', d: 'Logó, csomagolás és menütervek egy helyi kávézónak.', a: 'brand' },
  { t: 'Applikáció-felület', d: 'Mobilos felület kattintható prototípussal.', a: 'app' },
  { t: 'Rendezvény-plakát', d: 'Nyomtatott és digitális kampányanyagok.', a: 'poster' },
];
const services = ['Logó- és arculattervezés', 'Nyomtatott anyagok', 'Weboldal- és appfelület-tervek', 'Közösségi média sablonok'];
const rates = [{ n: 'Logótervezés', p: '80 000 Ft-tól' }, { n: 'Arculati csomag', p: '180 000 Ft-tól' }, { n: 'Óradíj', p: '9 000 Ft' }];
---
<DemoLayout title="Szolgáltatói Portfólió Minta">
  <div id="top" class="min-h-screen bg-white font-sans text-slate-800">
    <DemoHeader brand="Minta Dóri" links={[{ href: '#munkak', label: 'Munkák' }, { href: '#arak', label: 'Árak' }]} cta="Írj nekem" ctaHref="mailto:minta@pelda.hu" brandClass="text-violet-700" btnClass="bg-violet-600 hover:bg-violet-700" />
    <main>
      <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-12 md:grid-cols-2 md:py-20">
        <div>
          <p class="font-semibold text-violet-600">Szabadúszó grafikus</p>
          <h1 class="mt-3 font-display text-5xl font-extrabold leading-tight text-slate-900 sm:text-6xl">Arculatok, amelyekre emlékeznek.</h1>
          <p class="mt-5 max-w-[46ch] text-lg text-slate-600">Kisvállalkozásoknak tervezek egyszerű, felismerhető megjelenést a logótól a plakátig.</p>
          <a href="#munkak" class="mt-8 inline-block rounded-xl bg-violet-600 px-7 py-3 font-semibold text-white shadow-lg shadow-violet-600/30 transition hover:-translate-y-0.5">Munkáim megtekintése</a>
        </div>
        <div class="h-72 overflow-hidden rounded-3xl shadow-xl md:h-96"><DemoArt name="folio" label="Színes, absztrakt formák kompozíciója" /></div>
      </section>

      <section id="munkak" class="mx-auto max-w-6xl scroll-mt-4 px-5 py-12" aria-labelledby="wh">
        <h2 id="wh" class="font-display text-3xl font-extrabold text-slate-900">Válogatott munkák</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-3">
          {works.map((w) => (
            <li class="overflow-hidden rounded-2xl ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl">
              <div class="h-52"><DemoArt name={w.a} label={w.t} /></div>
              <div class="p-5"><h3 class="font-display text-lg font-bold">{w.t}</h3><p class="mt-1 text-sm text-slate-600">{w.d}</p></div>
            </li>
          ))}
        </ul>
      </section>

      <section class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-2" aria-label="Szolgáltatások és árak">
        <div>
          <h2 class="font-display text-3xl font-extrabold text-slate-900">Miben segítek?</h2>
          <ul class="mt-6 space-y-3">
            {services.map((s) => <li class="flex gap-3"><svg class="mt-1 shrink-0 text-violet-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>{s}</li>)}
          </ul>
        </div>
        <div id="arak" class="scroll-mt-4">
          <h2 class="font-display text-3xl font-extrabold text-slate-900">Árak</h2>
          <dl class="mt-6 divide-y divide-slate-200 rounded-2xl ring-1 ring-slate-200">
            {rates.map((r) => <div class="flex justify-between px-5 py-4"><dt>{r.n}</dt><dd class="font-semibold text-violet-700">{r.p}</dd></div>)}
          </dl>
        </div>
      </section>

      <section class="mx-auto max-w-4xl px-5 py-12 text-center">
        <div class="rounded-3xl bg-violet-600 p-10 text-white">
          <h2 class="font-display text-3xl font-extrabold">Dolgozzunk együtt!</h2>
          <p class="mt-2 text-violet-100">Írd meg röviden, mire van szükséged, és 2 munkanapon belül válaszolok.</p>
          <a href="mailto:minta@pelda.hu" class="mt-6 inline-block rounded-xl bg-white px-7 py-3 font-semibold text-violet-700 transition hover:-translate-y-0.5">minta@pelda.hu</a>
        </div>
      </section>
    </main>
    <DemoFooter brand="Minta Dóri" />
  </div>
</DemoLayout>
