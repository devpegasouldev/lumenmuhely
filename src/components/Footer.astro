---
const year = new Date().getFullYear();
const quick = [
  { href: '/szolgaltatasok', label: 'Szolgáltatások' },
  { href: '/rolunk', label: 'Rólunk' },
  { href: '/kapcsolat', label: 'Kapcsolat' },
];
---
<footer class="border-t border-white/10">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-2">
    <div>
      <p class="font-display text-xl font-extrabold">Lumen<span class="text-iris">.</span>műhely</p>
      <p class="mt-3 max-w-[36ch] text-mist">Weboldalak és digitális termékek tervezése és fejlesztése kis- és középvállalkozásoknak.</p>
    </div>
    <nav aria-label="Gyorslinkek">
      <p class="font-semibold">Gyorslinkek</p>
      <ul class="mt-3 space-y-2">
        {quick.map((l) => <li><a href={l.href} class="text-mist transition-colors hover:text-snow">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="border-t border-white/10 px-5 py-6 text-center text-sm text-mist">© {year} Lumen műhely. Minden jog fenntartva.</p>
</footer>
