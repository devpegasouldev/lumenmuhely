---
interface Props { name: string; role: string; bio: string; }
const { name, role, bio } = Astro.props;
const initials = name.split(' ').map((n) => n[0]).join('');
---
<article class="glass rounded-2xl p-7 text-center transition duration-300 hover:-translate-y-1 hover:border-iris/50">
  <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-gradient-to-br from-iris to-amber font-display text-2xl font-extrabold text-ink" aria-hidden="true">{initials}</div>
  <h3 class="mt-5 font-display text-xl font-bold">{name}</h3>
  <p class="text-sm text-iris">{role}</p>
  <p class="mt-3 text-mist">{bio}</p>
</article>
