---
interface Props { title: string; text: string; icon: string; }
const { title, text, icon } = Astro.props;
---
<article class="glass group rounded-2xl p-7 transition duration-300 hover:-translate-y-1 hover:border-iris/50 hover:bg-white/[.08]">
  <div class="grid h-12 w-12 place-items-center rounded-xl bg-iris/15 text-iris transition group-hover:bg-iris group-hover:text-white">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
  </div>
  <h3 class="mt-5 font-display text-xl font-bold">{title}</h3>
  <p class="mt-2 leading-relaxed text-mist">{text}</p>
</article>
