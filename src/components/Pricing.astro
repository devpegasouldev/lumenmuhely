---
const plans = [
  { name: 'Indulás', price: '99 000 Ft', note: 'Egyszeri díj', popular: false, cta: 'Ezt választom',
    features: ['Akár 5 aloldal', 'Reszponzív dizájn', 'Alap SEO-beállítások', '30 nap hibajavítás'] },
  { name: 'Növekedés', price: '219 000 Ft', note: 'Egyszeri díj', popular: true, cta: 'Ezt választom',
    features: ['Akár 12 aloldal', 'Egyedi arculati tervek', 'Kapcsolatfelvételi űrlap és mérés', 'Tartalomszerkesztő felület', '90 nap támogatás'] },
  { name: 'Egyedi', price: 'Ajánlat alapján', note: 'Igényeid szerint', popular: false, cta: 'Beszéljünk',
    features: ['Webshop vagy webalkalmazás', 'Rendszerintegrációk', 'Kiemelt, gyors kommunikáció', 'Folyamatos fejlesztés'] },
];
---
<section id="arak" class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-2xl text-center">
    <h2 id="pricing-title" class="font-display text-4xl font-extrabold tracking-tight">Átlátható csomagok, rejtett költségek nélkül</h2>
    <p class="mt-4 text-lg text-mist">Az árak nettó összegek. Az első konzultáció ingyenes.</p>
  </div>
  <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
    {plans.map((p) => (
      <article class:list={['relative flex flex-col rounded-3xl p-8 transition duration-300 hover:-translate-y-1', p.popular ? 'border border-iris bg-gradient-to-b from-iris/25 to-panel shadow-2xl shadow-iris/20 lg:-my-4 lg:py-12' : 'glass']}>
        {p.popular && <span class="absolute -top-3 left-8 rounded-full bg-amber px-3 py-1 text-xs font-semibold text-ink">Ajánlott</span>}
        <h3 class="font-display text-xl font-bold">{p.name}</h3>
        <p class="mt-4 font-display text-3xl font-extrabold">{p.price}</p>
        <p class="text-sm text-mist">{p.note}</p>
        <ul class="mt-7 flex-1 space-y-3">
          {p.features.map((f) => (
            <li class="flex gap-3 text-mist">
              <svg class="mt-1 shrink-0 text-iris" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>{f}
            </li>
          ))}
        </ul>
        <a href="/kapcsolat" class:list={['mt-8 rounded-xl px-5 py-3 text-center font-semibold transition hover:brightness-110', p.popular ? 'bg-amber text-ink' : 'bg-white/10 hover:bg-white/15']}>{p.cta}</a>
      </article>
    ))}
  </div>
</section>
