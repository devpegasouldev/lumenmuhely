---
interface Props { title: string; lead: string; }
const { title, lead } = Astro.props;
---
<header class="mx-auto max-w-6xl px-5 pb-10 pt-20">
  <h1 class="max-w-3xl font-display text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">{title}</h1>
  <p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-mist">{lead}</p>
</header>
