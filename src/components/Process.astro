---
const steps = [
  { title: 'Ismerkedés', text: 'Ingyenes konzultáción megbeszéljük a céljaidat, a költségkeretet és az időzítést.' },
  { title: 'Tervezés', text: 'Drótvázat és arculati terveket készítünk, amelyeket visszajelzéseid alapján finomítunk.' },
  { title: 'Fejlesztés', text: 'Megépítjük az oldalt, és végig teszt-környezetben mutatjuk a haladást.' },
  { title: 'Tesztelés', text: 'Minden eszközön és böngészőn ellenőrizzük, majd közösen jóváhagyjuk a végleges változatot.' },
  { title: 'Átadás', text: 'Élesítjük az oldalt, betanítunk a szerkesztésre, és vállaljuk a támogatást.' },
];
---
<section class="mx-auto max-w-6xl px-5 py-20" aria-labelledby="process-title">
  <h2 id="process-title" class="max-w-2xl font-display text-4xl font-extrabold tracking-tight">Így zajlik a közös munka</h2>
  <ol class="mt-12 space-y-4 border-l border-white/15 pl-8">
    {steps.map((s, i) => (
      <li class="relative">
        <span class="absolute -left-[3.15rem] grid h-10 w-10 place-items-center rounded-full bg-iris font-display font-bold text-white shadow-lg shadow-iris/30" aria-hidden="true">{i + 1}</span>
        <div class="glass rounded-2xl p-6 transition duration-300 hover:translate-x-1">
          <h3 class="font-display text-xl font-bold">{s.title}</h3>
          <p class="mt-1 text-mist">{s.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
