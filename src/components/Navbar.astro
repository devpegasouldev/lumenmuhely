---
import ThemeToggle from './ThemeToggle.astro';
const links = [
  { href: '/', label: 'Főoldal' },
  { href: '/szolgaltatasok', label: 'Szolgáltatások' },
  { href: '/rolunk', label: 'Rólunk' },
  { href: '/kapcsolat', label: 'Kapcsolat' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Fő navigáció">
    <a href="/" class="font-display text-xl font-extrabold tracking-tight">Lumen<span class="text-iris">.</span>műhely</a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}
             class:list={['rounded-lg px-3 py-2 text-sm transition-colors hover:text-snow', path === l.href ? 'text-snow' : 'text-mist']}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href="/kapcsolat" class="hidden rounded-xl bg-amber px-4 py-2 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:brightness-110 md:inline-block">Ingyenes konzultáció</a>

    <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü megnyitása"
            class="glass rounded-lg p-2 md:hidden">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/10 px-5 pb-5 md:hidden">
    <ul class="flex flex-col gap-1 pt-3">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-lg px-3 py-3 text-mist transition-colors hover:bg-white/5 hover:text-snow">{l.label}</a></li>
      ))}
    </ul>
    <a href="/kapcsolat" class="mt-3 block rounded-xl bg-amber px-4 py-3 text-center font-semibold text-ink">Ingyenes konzultáció</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!hidden));
  });
</script>
