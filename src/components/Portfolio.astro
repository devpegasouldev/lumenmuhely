---
import DemoArt from './DemoArt.astro';
const filters = ['Mind', 'Landing page', 'Webshop', 'Portfólió'];
const works = [
  { art: 'klima', href: '/demo/klimatech', title: 'KlímaTech Landing Page Demó', cat: 'Landing page', from: 'from-iris/50', to: 'to-panel',
    text: 'Egyoldalas bemutatkozó oldal légkondicionáló-szerelő cégeknek: látványos nyitóképernyő, szolgáltatáskártyák és egykattintásos ajánlatkérés.',
    tags: ['Astro', 'Tailwind CSS', 'Mobil-első'], goal: 'Lighthouse-cél: 100/100' },
  { art: 'notebook', href: '/demo/webshop', title: 'E-commerce Webshop Koncepció', cat: 'Webshop', from: 'from-amber/40', to: 'to-iris/30',
    text: 'Szűrhető terméklista, gyors termékoldalak és letisztult kosár, amely mobilon is egy kézzel kezelhető.',
    tags: ['Next.js', 'Tailwind CSS', 'Villámgyors betöltés'], goal: 'Betöltési cél: 1 mp alatt' },
  { art: 'folio', href: '/demo/portfolio', title: 'Szolgáltatói Portfólió Minta', cat: 'Portfólió', from: 'from-panel', to: 'to-iris/50',
    text: 'Szabadúszóknak és kisvállalkozásoknak: bemutatkozás, munkák, árak és kapcsolatfelvétel egyetlen átlátható oldalon.',
    tags: ['Astro', 'Akadálymentes', 'SEO-barát'], goal: 'Lighthouse-cél: 100/100' },
  { art: 'soup', href: '/demo/etterem', title: 'Helyi Étterem Foglalási Demó', cat: 'Landing page', from: 'from-iris/30', to: 'to-amber/30',
    text: 'Étlap, nyitvatartás és asztalfoglalási űrlap egy mobilra tervezett oldalon, amely a telefonról érkezőknek készült.',
    tags: ['Astro', 'Tailwind CSS', 'Mobil-első'], goal: 'Mobil-első kialakítás' },
];
---
<section id="prototipusok" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20" aria-labelledby="work-title">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-xl">
      <h2 id="work-title" class="font-display text-4xl font-extrabold tracking-tight">Prototípusaink</h2>
      <p class="mt-4 text-lg text-mist">Ezek saját tervezésű minta-koncepciók, nem valódi ügyfélmunkák. Megmutatják, milyen sebességet és minőséget hozunk az Ön projektjébe is.</p>
    </div>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Prototípusok szűrése">
      {filters.map((f, i) => (
        <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}
          class="glass rounded-full px-4 py-2 text-sm transition hover:bg-white/10 aria-pressed:border-iris aria-pressed:bg-iris aria-pressed:text-white">{f}</button>
      ))}
    </div>
  </div>
  <ul id="work-grid" class="mt-10 grid gap-5 sm:grid-cols-2">
    {works.map((w) => (
      <li data-cat={w.cat}>
        <article class="glass group relative h-full overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1 hover:border-iris/50">
          <div class="relative h-48 overflow-hidden transition duration-500 group-hover:scale-[1.02]">
            <DemoArt name={w.art} label={`${w.title} vizuális előnézete`} />
            <span class="absolute left-4 top-4 rounded-full bg-ink/70 px-3 py-1 text-xs font-semibold text-snow">Demó projekt</span>
          </div>
          <div class="p-6">
            <span class="text-sm text-iris">{w.cat}</span>
            <h3 class="mt-1 font-display text-xl font-bold"><a href={w.href} class="after:absolute after:inset-0">{w.title}</a></h3>
            <p class="mt-2 leading-relaxed text-mist">{w.text}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {w.tags.map((t) => <li class="rounded-full bg-white/10 px-3 py-1 text-xs text-mist">{t}</li>)}
            </ul>
            <p class="mt-4 font-semibold text-amber">{w.goal}</p>
            <p class="mt-3 text-sm font-semibold text-iris">Demó megtekintése</p>
          </div>
        </article>
      </li>
    ))}
  </ul>
  <p class="mt-6 text-sm text-mist">A Lighthouse-értékek fejlesztési célok. Éles projektnél átadás előtt lefuttatjuk a mérést, és megmutatjuk az eredményt.</p>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('#work-grid [data-cat]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((i) => i.classList.toggle('hidden', f !== 'Mind' && i.dataset.cat !== f));
    })
  );
</script>
